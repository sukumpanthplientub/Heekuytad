{
  "name": "supersix-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal creative job tracker with SQLite and file uploads; ready for a Render persistent disk.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs",
    "format": "prettier --write src server index.html vite.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "express": "5.3.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
