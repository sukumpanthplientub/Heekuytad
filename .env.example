# Set these in Render Environment. Never commit real passwords or .env files.
APP_MODE=hosted
APP_USERNAME=super6
# Required: your own password with at least 16 characters.
APP_PASSWORD=
STORAGE_PATH=/var/data/supersix-studio
MAX_UPLOAD_MB=500

# Render provides PORT and RENDER_EXTERNAL_URL automatically.
# Set PUBLIC_URL only for a custom domain or another hosting provider.
# PUBLIC_URL=https://your-domain.example

# Optional local development outside Render:
# APP_MODE=local
# PORT=3000
# STORAGE_PATH=./data
